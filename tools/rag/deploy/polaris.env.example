# /etc/polaris.env 로 복사하고 값을 채운 뒤: sudo chown root:root /etc/polaris.env && sudo chmod 600 /etc/polaris.env
RAG_ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
ALLOW_ORIGIN=https://caurfs.kr,https://www.caurfs.kr
ANON_DAILY=5
PER_IP_DAILY=40
DAILY_LIMIT=100
# 질문·답·출처를 남겨 평가셋 보강에 쓴다 (사람 정보는 남기지 않는다). 안 남기려면 이 줄을 지운다
LOG_PATH=/srv/polaris/log/chat.jsonl
