# 키움 REST API (openapi.kiwoom.com > 계좌 APP Key 관리)
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=
# 시험할 때만 1 (모의투자 서버)
KIWOOM_MOCK=0

# Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# 운용 시작일과 시작 금액(원). 기준가 1,000과 지수 비교의 기준
# 비워 두면 처음 실행한 날의 총자산을 1,000으로 잡고 그날부터 성과를 쌓는다
FUND_START=
FUND_BASE=
# 입출금 내역 (없으면 비워 둠). 예: 2026-05-01:+1000000,2026-09-01:-500000
FUND_FLOWS=

# 장중 조회 간격(초)
FUND_EVERY=15
